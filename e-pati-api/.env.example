NODE_ENV=development
PORT=3000

# PostgreSQL connection string. Do not commit real hosts, usernames, or passwords.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Comma-separated origins allowed by CORS.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8081,https://e-pati.vercel.app,https://vetcep.com,https://www.vetcep.com"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAME_SITE="lax"

# JWT secrets must be long random values in real environments.
JWT_ACCESS_SECRET="replace-with-access-token-secret"
JWT_REFRESH_SECRET="replace-with-refresh-token-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
QR_TOKEN_SECRET="replace-with-qr-token-secret"
QR_TOKEN_TTL="24h"

# Redis / queues
REDIS_URL="rediss://USER:PASSWORD@HOST:6379"

# Email provider
RESEND_API_KEY="re_..."
MAIL_FROM="VetCep <onboarding@resend.dev>"
# Optional: route all OTP emails to this address during testing.
OTP_EMAIL_TO=""

# Firebase push notifications
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
NOTIFICATION_WORKER_ENABLED="true"

# Meta WhatsApp Cloud API
META_WHATSAPP_API_VERSION="v20.0"
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
META_WHATSAPP_VERIFY_TOKEN="vetcep-whatsapp-webhook"
META_WHATSAPP_APP_SECRET=""
META_WHATSAPP_LANGUAGE="tr"
META_WHATSAPP_TEMPLATE_EXAM_SUMMARY="exam_summary"
META_WHATSAPP_TEMPLATE_VACCINE_REMINDER="vaccine_reminder"
META_WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER="appointment_reminder"
META_WHATSAPP_TEMPLATE_LAB_RESULT_READY="lab_result_ready"

# Cloudflare R2, S3-compatible storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
R2_SIGNED_URL_TTL_SECONDS="900"

# Billing webhook verification. Providers must sign
# HMAC_SHA256(`${x-vetcep-timestamp}.${rawBody}`) with this secret.
BILLING_WEBHOOK_SECRET=""
BILLING_WEBHOOK_TOLERANCE_SECONDS="300"
